<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/textView_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="27dp"
        android:text="TextView"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:id="@+id/textView_dept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="dept"
        android:layout_below="@+id/textView_name"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QTY"
        android:layout_toRightOf="@+id/textView_dept"
        android:layout_alignRight="@+id/textView_dept"
        android:layout_centerVertical="true"
        android:layout_alignEnd="@+id/textView_dept"/>
    <TextView
        android:id="@+id/textView_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:layout_alignParentBottom="true"/> &quot; /&gt;\10
    <TextView
        android:id="@+id/textView_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="35dp"
        android:text="TextView"
        android:layout_alignBaseline="@+id/textView_username"
        android:layout_alignBottom="@+id/textView_username"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="35dp"
        android:layout_alignParentEnd="true"/>
    <Button
        android:id="@+id/button4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="C"
        android:layout_toRightOf="@+id/button_scan"
        android:layout_alignParentTop="true"
        android:onClick="Onclear"
        android:layout_toEndOf="@+id/button_scan"/>
    <TextView
        android:id="@+id/textView_barcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="barcode"
        android:layout_alignBaseline="@+id/textView_dept"
        android:layout_alignRight="@+id/textView_shop"
        android:layout_alignBottom="@+id/textView_dept"
        android:layout_alignEnd="@+id/textView_shop"/>
    <EditText
        android:id="@+id/editText_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="QTY "
        android:ems="10"
        android:maxLength="4"
        android:layout_below="@+id/textView_barcode"
        android:layout_alignLeft="@+id/button"
        android:layout_alignRight="@+id/button4"
        android:inputType="numberSigned"
        android:layout_alignStart="@+id/button"
        android:layout_alignEnd="@+id/button4"/>
    <Button
        android:id="@+id/button2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"
        android:layout_below="@+id/editText_qty"
        android:layout_alignRight="@+id/editText_qty"
        android:layout_alignBottom="@+id/textView10"
        android:onClick="Onsave"
        android:layout_alignEnd="@+id/editText_qty"/>
    <TextView
        android:textColor="@android:color/holo_red_dark"
        android:id="@+id/textView_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Item Name"
        android:layout_below="@+id/textView_itemcode"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textColor="@android:color/holo_red_dark"
        android:textColorHighlight="@android:color/holo_red_dark"
        android:textColorLink="@android:color/holo_red_dark"
        android:id="@+id/textView_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Price"
        android:layout_above="@+id/textView_name"
        android:layout_alignLeft="@+id/button_scan"
        android:layout_alignStart="@+id/button_scan"/>
    <TextView
        android:textColor="?attr/colorPrimaryDark"
        android:textColorLink="@android:color/holo_orange_light"
        android:id="@+id/textView_shop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="shop"
        android:layout_above="@+id/textView_name"
        android:layout_alignRight="@+id/button_scan"
        android:layout_alignEnd="@+id/button_scan"/>
    <TextView
        android:id="@+id/textView_itemcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="CODE"
        android:layout_below="@+id/button_scan"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/button_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="scan"
        android:layout_toLeftOf="@+id/textView_zone"
        android:layout_alignParentTop="true"
        android:onClick="Onscan"
        android:layout_toStartOf="@+id/textView_zone"/>
    <EditText
        android:id="@+id/editText_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint=" Item code"
        android:ems="10"
        android:layout_alignBaseline="@+id/button_scan"
        android:layout_alignBottom="@+id/button_scan"
        android:layout_alignParentLeft="true"
        android:inputType="textCapCharacters"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="33dp"
        android:text="back"
        android:layout_above="@+id/textView_username"
        android:layout_alignParentLeft="true"
        android:onClick="Onback"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="VIEW"
        android:layout_above="@+id/button_back"
        android:layout_alignRight="@+id/button4"
        android:layout_alignParentLeft="true"
        android:onClick="Onview"
        android:layout_alignEnd="@+id/button4"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/button_Exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLOSE"
        android:layout_alignBaseline="@+id/button_back"
        android:layout_alignBottom="@+id/button_back"
        android:layout_alignParentRight="true"
        android:onClick="Onexit"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
