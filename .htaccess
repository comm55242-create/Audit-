RewriteEngine On

# Rules for Stock Take App
RewriteRule ^shop_audit\.php$ /Audit_new/admin_audit/shop_audit.php [L]
RewriteRule ^upload_audit_shop\.php$ /Audit_new/admin_audit/upload_audit_shop.php [L]
RewriteRule ^shop_report\.php$ /Audit_new/admin_audit/shop_report.php [L]

# Rules for Recounting App
RewriteRule ^recount/api/request_approval\.php$ /Audit_new/recount/api/request_approval.php [L]
RewriteRule ^recount/api/shop_audit\.php$ /Audit_new/recount/api/shop_audit.php [L]
RewriteRule ^recount/api/upload_audit_shop\.php$ /Audit_new/recount/api/upload_audit_shop.php [L]
RewriteRule ^recount/api/shop_report\.php$ /Audit_new/recount/api/shop_report.php [L]
